---
// The MikeTaps monogram: a bare MT drawn like circuit traces, gold lines ending
// in burgundy vias over a burgundy rule. Colors come from --mark-* in global.css
// so the gold stays readable on the light paper and the dark room.
// Ships with an 8-bit twin that only shows during the Konami code easter egg.
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---
<span class="mono" style={`--size:${size}px`} aria-hidden="true">
  <svg class="mono-hd" viewBox="-42 -40 84 84" width={size} height={size}>
    <path class="rule" d="M-38,35H38" stroke-width="3" stroke-linecap="round" />
    <polyline class="trace" points="-34,24 -34,-26 -17,0 0,-26 0,24" fill="none" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
    <path class="trace" d="M0,-26H36M18,-26V24" fill="none" stroke-width="5.5" stroke-linecap="round" />
    <g class="via" stroke-width="2.2">
      <circle cx="-34" cy="24" r="5" />
      <circle cx="0" cy="24" r="5" />
      <circle cx="18" cy="24" r="5" />
      <circle cx="36" cy="-26" r="5" />
    </g>
  </svg>
  <svg class="mono-8" viewBox="0 0 16 16" width={size} height={size} shape-rendering="crispEdges">
    <g class="px-gold">
      <rect x="1" y="3" width="1" height="10" />
      <rect x="2" y="4" width="1" height="1" />
      <rect x="3" y="5" width="1" height="1" />
      <rect x="4" y="6" width="1" height="1" />
      <rect x="5" y="5" width="1" height="1" />
      <rect x="6" y="4" width="1" height="1" />
      <rect x="7" y="3" width="1" height="10" />
      <rect x="8" y="3" width="6" height="1" />
      <rect x="10" y="4" width="1" height="9" />
    </g>
    <g class="px-dot">
      <rect x="1" y="13" width="1" height="1" />
      <rect x="7" y="13" width="1" height="1" />
      <rect x="10" y="13" width="1" height="1" />
      <rect x="14" y="3" width="1" height="1" />
      <rect x="1" y="15" width="14" height="1" />
    </g>
  </svg>
</span>

<style>
  .mono {
    display: inline-grid;
    width: var(--size);
    height: var(--size);
  }
  .mono > svg {
    grid-area: 1 / 1;
  }
  .trace {
    stroke: var(--mark-gold);
  }
  .rule {
    stroke: var(--mark-rule);
  }
  .via {
    fill: var(--burgundy);
    stroke: var(--mark-gold);
  }
  .px-gold {
    fill: var(--mark-gold);
  }
  .px-dot {
    fill: var(--mark-rule);
  }
  .mono-8 {
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--base) var(--ease), transform var(--base) var(--pop);
  }
  :global(.eight-bit) .mono-8 {
    opacity: 1;
    transform: scale(1);
  }
  :global(.eight-bit) .mono-hd {
    opacity: 0;
  }
</style>
