p="round" opacity=".8"/><path d="M336 188 C 316 188, 296 189, 280 189 C 268 189, 259 193, 259 198 C 259 202, 266 203, 276 203 C 296 203, 318 205, 336 205 Z" fill="#e0b08a"/><path d="M300 189.5 C 290 189, 282 189, 274 189.5 C 265 190.5, 259 193, 259 198 C 259 202, 266 203, 276 203 C 296 203, 318 205, 336 205" stroke="#c8946c" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M262 194 C 265 192.5, 269 192.5, 271 194.5" stroke="#a8714c" stroke-width="1.4" fill="none" stroke-linecap="round"/></g>
      <g class="wl-mike"><path d="M232.2 175.8 L 100.3 85.2 L 128.4 46.3 L 255.7 143.4 Z" fill="#b47c56"/><path class="gi" d="M158.0 141.9 L 1.8 33.7 L 48.7 -31.1 L 200.3 83.5 Z" fill="#f4efe6"/><path d="M156.0 137.9 L 195.8 82.8" stroke="#ddd3c4" stroke-width="5"/><path d="M272.4 198.7 C 290.8 210.8, 303.9 216.6, 312.2 210.3" stroke="#93603f" stroke-width="14.0" fill="none" stroke-linecap="round"/><path d="M272.4 198.7 C 290.8 210.8, 303.9 216.6, 312.2 210.3" stroke="#b47c56" stroke-width="10.5" fill="none" stroke-linecap="round"/><path d="M288.9 215.2 Q 293.5 212.2 293.2 209.3" stroke="#93603f" stroke-width="1.3" fill="none" opacity=".7"/><path d="M278.3 190.6 C 299.1 204.5, 312.2 210.3, 321.2 203.0" stroke="#93603f" stroke-width="14.5" fill="none" stroke-linecap="round"/><path d="M278.3 190.6 C 299.1 204.5, 312.2 210.3, 321.2 203.0" stroke="#b47c56" stroke-width="11" fill="none" stroke-linecap="round"/><path d="M297.1 209.0 Q 301.8 205.9 301.6 202.8" stroke="#93603f" stroke-width="1.3" fill="none" opacity=".7"/><path d="M284.1 182.5 C 303.3 195.2, 316.4 201.0, 325.0 194.3" stroke="#93603f" stroke-width="14.0" fill="none" stroke-linecap="round"/><path d="M284.1 182.5 C 303.3 195.2, 316.4 201.0, 325.0 194.3" stroke="#b47c56" stroke-width="10.5" fill="none" stroke-linecap="round"/><path d="M301.4 199.6 Q 306.1 196.6 305.7 193.6" stroke="#93603f" stroke-width="1.3" fill="none" opacity=".7"/><path d="M290.0 174.4 C 304.4 183.6, 317.5 189.4, 324.6 184.7" stroke="#93603f" stroke-width="12.5" fill="none" stroke-linecap="round"/><path d="M290.0 174.4 C 304.4 183.6, 317.5 189.4, 324.6 184.7" stroke="#b47c56" stroke-width="9" fill="none" stroke-linecap="round"/><path d="M302.7 187.6 Q 307.1 185.0 306.4 182.5" stroke="#93603f" stroke-width="1.3" fill="none" opacity=".7"/><path d="M224.7 169.1 C 238.0 184.9, 257.9 201.8, 273.2 207.9 L 301.0 176.3 C 285.6 160.1, 263.3 146.5, 247.0 138.4 Z" fill="#b47c56"/><path d="M270.6 201.2 C 280.9 193.8, 288.0 184.1, 293.4 173.2" stroke="#93603f" stroke-width="1.6" fill="none" opacity=".7"/><path d="M243.7 180.4 Q 255.1 202.2 283.7 221.5" stroke="#93603f" stroke-width="14.5" fill="none" stroke-linecap="round"/><path d="M243.7 180.4 Q 255.1 202.2 283.7 221.5" stroke="#b47c56" stroke-width="11" fill="none" stroke-linecap="round"/><path d="M279.7 222.5 Q 283.7 218.5 286.7 223.5" stroke="#93603f" stroke-width="1.4" fill="none" opacity=".8"/></g>
      <g class="wl-taps"><text class="tap t1" x="372" y="112">tap</text><text class="tap t2" x="420" y="90">tap</text><text class="tap t3" x="464" y="114">tap</text></g>
    </svg>
  </button>
  <p class="wl-cap" aria-live="polite"><span class="wl-hint" data-wl-hint>slap and bump?</span><span class="wl-line" data-wl-line hidden></span></p>
</div>

<style>
  .wl {
    width: min(100%, 380px);
  }
  .wl-btn {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 14px;
  }
  .wl-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
  .wl-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
  /* white gi sleeves get a soft edge so they still show on the light theme */
  .gi {
    stroke: #c9bba6;
    stroke-width: 1.5;
  }
  .wl-hand {
    transform-box: view-box;
    transform-origin: 330px 181px;
    transition: transform 320ms cubic-bezier(0.3, 1.25, 0.5, 1);
  }
  .wl-mike {
    transform-box: view-box;
    transform: translate(-170px, -120px);
    opacity: 0;
    transition: transform 300ms ease, opacity 180ms ease;
  }
  .wl.is-locked .wl-hand {
    transform: rotate(-62deg);
    transition-delay: 200ms;
  }
  .wl.is-locked .wl-mike {
    transform: none;
    opacity: 1;
  }
  .tap {
    font: 600 20px var(--font-mono);
    fill: var(--gold);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wl.is-locked .tap {
    animation: wl-tap 700ms ease-out forwards;
  }
  .wl.is-locked .t1 { animation-delay: 0.55s; }
  .wl.is-locked .t2 { animation-delay: 0.85s; }
  .wl.is-locked .t3 { animation-delay: 1.15s; }
  .wl-cap {
    min-height: 3em;
    margin: 0.3rem 0 0;
    text-align: center;
  }
  .wl-hint {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-faint);
    opacity: 0.8;
    transition: opacity var(--fast) var(--ease);
  }
  .wl-btn:hover + .wl-cap .wl-hint,
  .wl-btn:focus-visible + .wl-cap .wl-hint {
    opacity: 1;
  }
  .wl-line {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .wl-line[hidden],
  .wl-hint[hidden] {
    display: none;
  }
  @keyframes wl-tap {
    0% { opacity: 0; transform: translateY(8px) scale(0.7); }
    30% { opacity: 1; transform: none; }
    80% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wl-hand,
    .wl-mike {
      transition: none;
    }
    .wl.is-locked .tap {
      animation: none;
      opacity: 1;
    }
  }
</style>
