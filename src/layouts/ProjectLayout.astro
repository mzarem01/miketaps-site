---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const { title, summary, stack = [], repo, broke, kind = 'Project', date } = frontmatter;
---
<Base title={title} description={summary} accent="#c29b45">
  <article class="project">
    <header class="wrap head">
      <a class="back" href="/work/">&larr; All work</a>
      <p class="eyebrow">{kind}{date ? ` · ${date}` : ''}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <ul class="stack" aria-label="Built with">
        {stack.map((s: string) => <li>{s}</li>)}
      </ul>
      {broke && (
        <p class="broke"><span>What broke:</span> {broke}</p>
      )}
    </header>
    <div class="wrap body">
      <div class="prose content">
        <slot />
      </div>
      <aside class="side">
        {repo && (
          <a class="repo" href={repo}>
            <span class="eyebrow">Source and full write-up</span>
            <span>{repo.replace('https://github.com/', '')}</span>
          </a>
        )}
        <p class="note">Addresses, hostnames and identifiers are left out on purpose.</p>
      </aside>
    </div>
  </article>
</Base>

<style>
  .project {
    --blue: #1f3a4f;
    padding-bottom: 3rem;
  }
  .head {
    position: relative;
    padding-top: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: 2rem;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    mask-image: linear-gradient(to bottom, black 40%, transparent);
  }
  .head > * {
    position: relative;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .head h1 {
    margin-top: 0.5rem;
    max-width: 22ch;
  }
  .summary {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--rule);
    background: var(--card);
  }
  .broke {
    display: inline-block;
    max-width: 44rem;
    padding: 0.7rem 1rem;
    border-left: 4px solid var(--gold);
    background: var(--gold-tint);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 1rem;
  }
  .broke span {
    font-weight: 700;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 3rem;
  }
  .side {
    position: sticky;
    top: 90px;
    align-self: start;
  }
  .repo {
    display: grid;
    gap: 0.3rem;
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--card);
    text-decoration: none;
    word-break: break-word;
  }
  .note {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .content :global(h2) {
    margin-top: 2.2rem;
    font-size: 1.7rem;
  }
  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
  }
  .content :global(figure) {
    margin: 1.5rem 0;
  }
  .content :global(figcaption) {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-top: 0.4rem;
  }
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
    margin: 1rem 0 1.5rem;
  }
  .content :global(th),
  .content :global(td) {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }
  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .content :global(pre) {
    background: #151112;
    color: #e9dfd2;
    padding: 1rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .content :global(pre code) {
    background: none;
    padding: 0;
  }
  .content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 3px solid var(--burgundy);
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .side {
      position: static;
      order: -1;
    }
  }
</style>
