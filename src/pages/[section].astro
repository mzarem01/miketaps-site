---
// Stub page for each room until its real experience is built.
import Base from '../layouts/Base.astro';
import { sections, type Section } from '../data/sections';

export function getStaticPaths() {
  return sections.map((s) => ({ params: { section: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Section };
---
<Base title={s.name} description={s.blurb} accent={s.accent}>
  <section class="wrap stub" style={`--c:${s.accent}`}>
    <p class="eyebrow">Room: {s.object}</p>
    <h1>{s.name}</h1>
    <hr class="bar" />
    <p class="lede prose">{s.blurb}</p>
    <div class="card prose">
      <p class="eyebrow">Being built</p>
      <p>This room is still being set up. Planned feel: <em>{s.mood.toLowerCase()}</em>.</p>
      <a class="btn" href="/">Back to the workshop</a>
    </div>
  </section>
</Base>

<style>
  .stub {
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.25rem 4rem;
  }
  .bar {
    width: 5rem;
    height: 4px;
    border: 0;
    border-radius: 2px;
    background: var(--c);
    margin: 0.5rem 0 1.5rem;
  }
  .lede {
    font-size: 1.3rem;
    color: var(--ink-soft);
  }
  .card {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px dashed var(--rule);
  }
</style>
