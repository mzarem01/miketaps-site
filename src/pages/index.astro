---
import Base from '../layouts/Base.astro';

// Phase 0 placeholder. The about text is Mike's approved draft (Nov 14, 2026).
const comingUp = [
  { name: 'Work', note: 'Projects, write-ups and postmortems' },
  { name: 'Commanders history', note: 'Random facts, every one with a source' },
  { name: 'Verses', note: 'Scripture for whatever you are dealing with' },
  { name: 'How this site runs', note: 'The setup behind it, minus the private bits' },
];
---
<Base>
  <section class="hero">
    <p class="eyebrow">Field notes</p>
    <h1>Things I've built,<br />and why.</h1>
    <hr class="rule short" />
    <div class="prose">
      <p>
        I'm Mike. I work in security and I'm working my way into cybersecurity, one home lab
        project at a time. I run my own server, a segmented home network, backups I actually
        test, and a local AI setup I can't stop tinkering with. This site is part of that lab:
        I built it, I host it, and when it breaks, I fix it here in the open.
      </p>
      <p>
        Outside the terminal, I'm a Commanders fan, a jiu-jitsu purple belt who's been training
        and coaching since 2010, and a guy who leans on his faith. Look around.
      </p>
    </div>
    <p class="tags">
      <span class="chip">Homelab</span>
      <span class="chip">Security</span>
      <span class="chip">Local AI</span>
      <span class="chip chip--gold">Faith</span>
    </p>
  </section>

  <section class="soon" aria-labelledby="soon-heading">
    <h2 id="soon-heading">Under construction</h2>
    <p class="lede">The site is being built right now, in small steps. Here's what's coming.</p>
    <ul>
      {comingUp.map((item) => (
        <li>
          <span class="name">{item.name}</span>
          <span class="note">{item.note}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding: 2.5rem 0 1rem;
  }
  .short {
    width: 4.5rem;
    margin: 1.25rem 0 1.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .soon {
    margin-top: 3rem;
    max-width: var(--measure);
  }
  .lede {
    color: var(--ink-soft);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--rule);
  }
  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }
  .note {
    color: var(--ink-faint);
    font-size: 0.98rem;
  }
  @media (max-width: 560px) {
    li {
      flex-direction: column;
    }
  }
</style>
