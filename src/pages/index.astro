---
import Base from '../layouts/Base.astro';
import WorkshopScene from '../components/WorkshopScene.astro';
import { sections } from '../data/sections';
---
<Base>
  <section class="wrap intro">
    <p class="eyebrow">Built and run at home</p>
    <h1>Come on in. <span class="soft">This is the workshop.</span></h1>
  </section>

  <section class="wrap scene-section" aria-label="The workshop">
    <WorkshopScene />
  </section>

  <section class="wrap about">
    <div class="about-text prose">
      <h2>I'm Mike.</h2>
      <p>
        I work in security and I'm working my way into cybersecurity, one home lab project at a
        time. I run my own server, a segmented home network, backups I actually test, and a local
        AI setup I can't stop tinkering with. This site is part of that lab: I built it, I host it,
        and when it breaks, I fix it here in the open.
      </p>
      <p>
        Outside the terminal, I'm a Commanders fan, a jiu-jitsu purple belt who's been training and
        coaching since 2010, and a guy who leans on his faith. Look around.
      </p>
    </div>
  </section>

  <section class="wrap map" aria-labelledby="map-heading">
    <div class="map-head">
      <h2 id="map-heading">Map of the room</h2>
      <p>Same places as the room above, for when you just want to get there.</p>
    </div>
    <ol class="map-list">
      {sections.map((s, i) => (
        <li style={`--c:${s.accent}`}>
          <a href={`/${s.slug}/`} class="map-card">
            <span class="num">0{i + 1}</span>
            <span class="map-name">{s.name}</span>
            <span class="map-blurb">{s.blurb}</span>
            <span class="map-object">In the room: {s.object}</span>
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(1.25rem, 3vw, 2.25rem);
    padding-bottom: 1rem;
  }
  .intro h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
  }
  .soft {
    color: var(--burgundy-text);
    font-style: italic;
    font-weight: 450;
  }
  .scene-section {
    padding-bottom: 2.5rem;
  }
  .about {
    padding: 1rem 1.25rem 2.5rem;
  }
  .about-text h2 {
    position: relative;
    display: inline-block;
  }
  .about-text h2::after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.2em;
    bottom: 0.02em;
    height: 0.32em;
    background: var(--gold);
    opacity: 0.35;
    z-index: -1;
  }
  .map {
    padding-bottom: 3rem;
  }
  .map-head p {
    color: var(--ink-soft);
    margin-top: -0.25rem;
  }
  .map-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .map-card {
    position: relative;
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.25rem 1.25rem 1.1rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--base) var(--pop), border-color var(--base) var(--ease), box-shadow var(--base) var(--ease);
  }
  .map-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--c);
    transition: width var(--base) var(--ease);
  }
  .map-card:hover,
  .map-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--c);
    box-shadow: 0 14px 30px -20px var(--c);
  }
  .map-card:hover::before,
  .map-card:focus-visible::before {
    width: 9px;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .map-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 560;
  }
  .map-blurb {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }
  .map-object {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .arrow {
    position: absolute;
    right: 1.1rem;
    top: 1.1rem;
    font-size: 1.2rem;
    color: var(--c);
    transition: transform var(--base) var(--pop);
  }
  .map-card:hover .arrow,
  .map-card:focus-visible .arrow {
    transform: translateX(4px);
  }
</style>
