            <circle cx="360" cy="47" r="10" class="fan-s" />
          </g>
          <g class="part" data-part="cpu" tabindex="0" role="button" aria-label="CPU">
            <rect x="320" y="110" width="70" height="70" rx="8" class="pc cpu" />
            <circle cx="355" cy="145" r="18" class="pump" />
          </g>
          <g class="part" data-part="ram" tabindex="0" role="button" aria-label="Memory">
            <rect x="408" y="96" width="12" height="96" rx="2" class="pc ram" />
            <rect x="428" y="96" width="12" height="96" rx="2" class="pc ram" />
          </g>
          <g class="part" data-part="ssd" tabindex="0" role="button" aria-label="Storage">
            <rect x="300" y="236" width="120" height="16" rx="3" class="pc ssd" />
          </g>
          <g class="part" data-part="gpu" tabindex="0" role="button" aria-label="Graphics card">
            <rect x="46" y="80" width="170" height="250" rx="10" class="pc gpu" />
            <circle cx="131" cy="135" r="34" class="gfan" />
            <circle cx="131" cy="205" r="34" class="gfan" />
            <circle cx="131" cy="275" r="34" class="gfan" />
            <rect x="52" y="86" width="6" height="238" fill="#c29b45" />
          </g>
          <g class="part" data-part="psu" tabindex="0" role="button" aria-label="Power">
