            </g>

            <g class="gear" data-gear="switch" tabindex="0" role="button" aria-label="Switch">
              <rect x="52" y="84" width="336" height="44" rx="5" class="u" />
              <text x="66" y="111" class="u-t">GS1900</text>
              {[0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
                <g><rect x={160 + n * 26} y="93" width="20" height="17" rx="2" class="port" /><circle cx={170 + n * 26} cy="118" r="2.4" class={n < 5 ? `led g b${(n + 1) % 3}` : 'led off'} /></g>
              ))}
              <circle cx="372" cy="106" r="3" class="led g" />
            </g>

            <g class="gear" data-gear="server" tabindex="0" role="button" aria-label="Server">
              <rect x="52" y="138" width="336" height="96" rx="6" class="u srv" />
              {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
                <rect x={70 + n * 14} y="156" width="6" height="60" rx="3" class="vent" />
              ))}
              <text x="210" y="176" class="u-t big">OPTIPLEX</text>
              <rect x="210" y="190" width="110" height="8" rx="2" class="slot" />
              <circle cx="356" cy="168" r="11" class="pwr" />
              <circle cx="356" cy="168" r="11" class="pwr-ring" />
              <circle cx="356" cy="200" r="2.8" class="led a b1" />
            </g>

            <g class="gear" data-gear="media" tabindex="0" role="button" aria-label="Media drive">
              <rect x="52" y="244" width="336" height="56" rx="6" class="u drv" />
              {[0, 1, 2, 3, 4, 5].map((n) => (
                <rect x="70" y={254 + n * 6} width="120" height="2.5" rx="1" class="grille" />
