---
import { BUILD } from '../../data/build';
import Base from '../../layouts/Base.astro';

const parts = [
  { id: 'cpu', name: 'CPU', model: 'AMD Ryzen 7 9800X3D', why: 'Eight cores with 3D V-Cache. Built for games, and it has plenty left over for everything else I throw at this box.' },
  { id: 'cooler', name: 'Cooler', model: '240 mm liquid cooler', why: 'Keeps the CPU in check day to day. Under an all-out stress test it hits its limit, so a repaste is on my list.' },
  { id: 'gpu', name: 'Graphics', model: 'XFX Radeon RX 9070 XT, 16 GB', why: 'Games, and my local AI. A 35-billion-parameter model fits entirely in its 16 GB once it is squeezed down.' },
  { id: 'ram', name: 'Memory', model: 'G.Skill 2 x 16 GB DDR5-6000', why: '32 GB with EXPO on. Passed four clean passes of MemTest86.' },
  { id: 'board', name: 'Motherboard', model: 'MSI PRO B650-VC WIFI', why: 'AM5, so there is an upgrade path for the CPU later.' },
  { id: 'ssd', name: 'Storage', model: 'WD Green SN3000 2 TB NVMe', why: 'Backed up every night to the home server with Kopia.' },
  { id: 'case', name: 'Case', model: 'HYTE Y40', why: 'Panoramic glass and a vertical GPU. Started life as a prebuilt, and I have been in it plenty since.' },
  { id: 'psu', name: 'Power', model: 'About 850 W, plus a CyberPower 1500 VA UPS', why: 'Tested clean under load. The UPS rides out power blips and talks to the PC over USB.' },
];

const services = [
  { name: 'Media server', note: 'Jellyfin, with hardware transcoding on the Intel iGPU' },
  { name: 'Photos', note: 'Immich, replacing cloud photo storage' },
  { name: 'DNS filtering', note: 'Pi-hole for the whole house' },
  { name: 'Monitoring', note: 'Uptime Kuma with chat alerts, plus an outside check-in for full outages' },
  { name: 'Backups', note: 'Nightly jobs that report in when they finish, a separate backup drive, and a monthly offsite copy' },
  { name: 'Power', note: 'UPS with automatic clean shutdown on low battery' },
  { name: 'This website', note: 'One locked-down container, the only public thing besides the media server' },
];

// The gear around the server, top to bottom as drawn in the rack.
const gear = [
  { id: 'router', name: 'Router and firewall', model: 'MikroTik hEX', why: 'Every connection to the server has to cross it. It runs an allow-list: my desktop gets full access, and everything else in the house gets DNS, the media server and the VPN. Nothing more.' },
  { id: 'switch', name: 'Switch', model: 'Zyxel GS1900-8', why: 'Managed, so it can carry VLANs. It runs on battery with the router, because a server with no network is just a warm box.' },
  { id: 'server', name: 'Server', model: 'Dell OptiPlex 5050 SFF, i7-7700, 32 GB', why: 'A used office PC that replaced my 2009 one in September 2026. It runs about twenty containers with no screen attached, and its Intel graphics handle video transcoding.' },
  { id: 'media', name: 'Media drive', model: '8 TB external', why: 'Pooled with an internal SSD into one folder using mergerfs. No RAID: if one disk dies, the files on the other are still readable, and backups cover the rest.' },
  { id: 'backup', name: 'Backup drive', model: '8 TB external', why: "Holds nothing but backups, and it's kept out of the pool, so one bad command can't wipe both copies. The nightly jobs check in with the monitor when they finish." },
  { id: 'offsite', name: 'Offsite drive', model: '4 TB, rotated monthly', why: "Usually not here, and that's the point. Once a month it gets a fresh copy and leaves the house." },
  { id: 'ups', name: 'UPS', model: 'CyberPower 1000 VA', why: 'Keeps the router, switch and server running through power blips. When the battery runs low, it tells the server to shut itself down cleanly.' },
];

// "Send a request" scenarios for the network diagram. Each path follows the lines drawn in it;
// a jump (M) means the request passes through a box, like Cloudflare or the router.
const traces = [
  { id: 'visitor', label: 'A visitor loads this site', ok: true, path: 'M188 117H250M400 117H440L460 140H476', note: 'Cloudflare handles HTTPS, then hands the request down a tunnel the server opened from inside the house. No port is open at home.' },
  { id: 'phone', label: 'I check the server from my phone', ok: true, path: 'M188 257H420V268H476', note: 'My own devices use a private mesh VPN. That is the only way in to the private services.' },
  { id: 'probe', label: 'Someone looks for an admin page', ok: false, path: 'M188 117H250', note: "Stopped at Cloudflare. Only this site and the media server are published, and every other path or hostname gets a 404. Nothing at home is listening for the internet." },
  { id: 'tv', label: 'A TV in the house plays a movie', ok: true, path: 'M770 220V180M680 145H640V205H624', note: 'The router firewall lets other devices in the house reach the media server and DNS.' },
  { id: 'cam', label: 'The pet camera pokes at the server', ok: false, path: 'M770 220V180', note: 'Dropped and logged by the router. Devices in the house only get what they need, and everything else on the server is off limits to them.' },
];

// Stories that play on the rack drawing. Each step lights up some gear and sets the
// rack's state (on battery, low battery, server off, offsite drive home).
const stories = [
  {
    id: 'power',
    label: 'Pull the plug',
    steps: [
      { gear: ['ups'], state: 'batt', title: 'The power goes out', text: "The UPS switches to battery right away. The router, switch and server don't even blink." },
      { gear: ['ups', 'server'], state: 'low', title: 'The battery runs low', text: 'The UPS tells the server, and the server shuts itself down cleanly instead of losing power in the middle of a write.' },
      { gear: ['server'], state: 'off', title: 'This site goes dark', text: "Nothing at home is answering, so Cloudflare shows its saved copy of the site instead of an error." },
      { gear: ['server'], state: 'off', title: 'Someone gets told', text: 'The server checks in with an outside service every few minutes. When the check-ins stop, an alert lands in my chat, even though the server can no longer send one itself.' },
      { gear: ['ups', 'server'], state: '', title: 'Power comes back', text: 'The UPS recharges. Once the server is back on, every service starts on its own and the monitor goes green again.' },
    ],
  },
  {
    id: 'backup',
    label: 'Follow a backup',
    steps: [
      { gear: ['server'], state: '', title: 'Overnight, the server packs up', text: "A nightly job bundles up every app's settings, and the photo database gets dumped to an internal disk." },
      { gear: ['server'], state: '', title: 'My desktop checks in too', text: 'My main PC backs itself up to the server every night.' },
      { gear: ['media', 'backup'], state: '', title: 'Copied to the backup drive', text: 'Then the media, the photos and those bundles get copied to the separate backup drive. Two disks, so one failure never takes both copies.' },
      { gear: ['server'], state: '', title: 'Every job reports in', text: "Each job pings the monitor when it finishes. If a ping doesn't arrive, I get an alert, so a backup can't quietly stop running." },
      { gear: ['offsite', 'backup'], state: 'home', title: 'Once a month, a copy leaves', text: "The offsite drive comes home, gets a fresh copy, and leaves again. A fire or a break-in can't take every copy at once." },
    ],
  },
];

// The 2009 office PC versus the OptiPlex. Bars are only drawn where there's a number to compare.
const compare = [
  { k: 'Built around', then: '2009', now: '2017' },
  { k: 'CPU', then: 'AMD Athlon II X4 620, 4 threads', now: 'Intel i7-7700, 8 threads', a: 4, b: 8 },
  { k: 'Memory', then: '8 GB', now: '32 GB', a: 8, b: 32 },
  { k: 'USB', then: 'USB 2.0 only', now: 'USB 3.0' },
  { k: 'External drive speed*', then: 'About 32 MB/s', now: 'About 202 MB/s', a: 32, b: 202 },
  { k: 'Hardware video transcoding', then: 'None', now: 'Intel Quick Sync: 0.8 s of CPU time for 20 s of 1080p video, versus 15.9 s in software*' },
];

// Real incidents, step by step. Everything here is from the write-ups linked on each one.
const incidents = [
  {
    id: 'load',
    title: 'Load 5.8, CPU 11%',
    when: 'August 2026',
    href: '/work/io-wait-postmortem/',
    steps: [
      { k: 'Symptom', t: 'Web pages on the server took seconds to load, SSH lagged and video stuttered. Load average: 5.78 on four cores.' },
      { k: 'First guess', t: 'The 2009 CPU is finally too slow. It fit every symptom, and it was wrong.' },
      { k: 'Evidence', t: 'All the containers together were using about 11 to 12 percent CPU. The box was waiting, not working.' },
      { k: 'Cause', t: "Disk I/O I'd set up myself: too many transfers at once on a spinning disk, and monitoring that sampled everything every second." },
      { k: 'Fix', t: 'Fewer transfers at once, and monitoring slowed to every 5 seconds. Load went from 5.78 to 3.23 within minutes. No hardware, no reboot.' },
    ],
  },
  {
    id: 'counters',
    title: 'The firewall that saw nothing',
    when: 'October 2026',
    href: '/work/network-upgrade/',
    steps: [
      { k: 'Symptom', t: 'I turned on the new firewall rules, tested, and everything worked.' },
      { k: 'Clue', t: "Every rule's counter read zero. A rule that never matches anything isn't filtering anything." },
      { k: 'Cause', t: "The router's switch chip was passing traffic between those ports in hardware, so the firewall never saw a packet." },
      { k: 'Fix', t: "Hardware offload off on the server's port, and IPv6 blocked there so nothing could route around the rules. The counters started climbing right away." },
      { k: 'Lesson', t: 'Check the counters, not just that things still work.' },
    ],
  },
  {
    id: 'ssh',
    title: 'Locked out by my own lock',
    when: '2026',
    href: '/work/homelab/',
    steps: [
      { k: 'Change', t: 'I made SSH key-only, so passwords stopped working entirely.' },
      { k: 'Symptom', t: "Two weeks later my phone couldn't sign in to the server." },
      { k: 'Cause', t: 'The phone had been relying on the door I just closed.' },
      { k: 'Fix', t: 'SSH through the mesh VPN, so the phone signs in with its VPN identity.' },
      { k: 'Lesson', t: 'Before closing a door, check what still uses it.' },
    ],
  },
];

// Embedded for the page script. "<" is escaped so the JSON can't close the script tag.
const storyJson = JSON.stringify(stories).replace(/</g, '\\u003c');

const built = new Date().toISOString().slice(0, 10);
---
<Base title="The Lab" description="The rig, the home server, and how this site runs, minus the private bits." accent="#3f8f6a">
  <div class="lab">
    <section class="wrap head">
      <p class="eyebrow">The Lab</p>
      <h1>The hardware behind it all.</h1>
      <p class="lede">My main rig, the home server that runs the house, and how this site gets from my keyboard to your screen.</p>
      <nav class="jump" aria-label="On this page">
        <a href="#rig">The rig</a>
        <a href="#homelab">The home server</a>
        <a href="#site">How this site runs</a>
      </nav>
    </section>

    <section id="rig" class="wrap rig" aria-labelledby="rig-h">
      <h2 id="rig-h">The rig</h2>
      <p class="sub">Click a part, or pick one from the list.</p>
      <div class="rig-grid">
        <div class="rig-view">
        <div class="view-bar">
          <button type="button" class="view-btn" data-rig-3d aria-pressed="false" hidden>View in 3D</button>
          <button type="button" class="view-btn quiet" data-rig-labels aria-pressed="false" hidden>Show labels</button>
          <button type="button" class="view-btn quiet" data-rig-reset hidden>Reset view</button>
          <span class="view-hint" data-rig-hint hidden>Drag to turn it, scroll or pinch to zoom, click a part.</span>
        </div>
        <div class="stage" data-rig-stage role="group" aria-label="3D model of the rig. Turn on labels to pick parts in the model, or use the parts list below." hidden></div>
        <svg class="case" viewBox="0 0 520 440" role="group" aria-label="The rig, with clickable parts">
          <rect x="10" y="10" width="500" height="420" rx="18" class="c-body" />
          <rect x="26" y="26" width="468" height="388" rx="10" class="c-glass" />
          <g class="part" data-part="board" tabindex="0" role="button" aria-label="Motherboard">
            <rect x="250" y="60" width="220" height="250" rx="6" class="pc board" />
          </g>
          <g class="part" data-part="cooler" tabindex="0" role="button" aria-label="Cooler">
            <rect x="60" y="34" width="400" height="26" rx="5" class="pc rad" />
            <circle cx="160" cy="47" r="10" class="fan-s" />
            <circle cx="360" cy="47" r="10" class="fan-s" />
          </g>
          <g class="part" data-part="cpu" tabindex="0" role="button" aria-label="CPU">
            <rect x="320" y="110" width="70" height="70" rx="8" class="pc cpu" />
            <circle cx="355" cy="145" r="18" class="pump" />
          </g>
          <g class="part" data-part="ram" tabindex="0" role="button" aria-label="Memory">
            <rect x="408" y="96" width="12" height="96" rx="2" class="pc ram" />
            <rect x="428" y="96" width="12" height="96" rx="2" class="pc ram" />
          </g>
          <g class="part" data-part="ssd" tabindex="0" role="button" aria-label="Storage">
            <rect x="300" y="236" width="120" height="16" rx="3" class="pc ssd" />
          </g>
          <g class="part" data-part="gpu" tabindex="0" role="button" aria-label="Graphics card">
            <rect x="46" y="80" width="170" height="250" rx="10" class="pc gpu" />
            <circle cx="131" cy="135" r="34" class="gfan" />
            <circle cx="131" cy="205" r="34" class="gfan" />
            <circle cx="131" cy="275" r="34" class="gfan" />
            <rect x="52" y="86" width="6" height="238" fill="#c29b45" />
          </g>
          <g class="part" data-part="psu" tabindex="0" role="button" aria-label="Power">
            <rect x="26" y="340" width="468" height="74" rx="6" class="pc shroud" />
            <text x="410" y="384" class="hyte">HYTE</text>
          </g>
          <g class="part" data-part="case" tabindex="0" role="button" aria-label="Case">
            <rect x="490" y="120" width="14" height="200" rx="4" class="pc edge" />
          </g>
        </svg>
        </div>

        <div class="detail" aria-live="polite">
          <p class="eyebrow" data-p-name>Part</p>
          <h3 data-p-model>Pick something in the case</h3>
          <p data-p-why>Every part has a reason it's in there. Some reasons are better than others.</p>
        </div>
      </div>

      <table class="specs">
        <caption class="sr-only">Full parts list</caption>
        <thead><tr><th>Part</th><th>Model</th><th>Notes</th></tr></thead>
        <tbody>
          {parts.map((p) => (
            <tr data-row={p.id}>
              <th scope="row"><button type="button" class="row-btn" data-part={p.id}>{p.name}</button></th>
              <td class="model">{p.model}</td>
              <td>{p.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="monitors">On the desk: an ASUS 27-inch 1440p 240 Hz OLED and an HP OMEN 34-inch ultrawide.</p>
    </section>

    <section id="homelab" class="wrap homelab" aria-labelledby="hl-h">
      <h2 id="hl-h">The home server</h2>
      <p class="sub">
        A Dell OptiPlex 5050 (i7-7700, 32 GB) running Debian and about twenty containers. It
        started as a 2009 office PC. <a href="/work/homelab/">The full story is in Work.</a>
      </p>

      <h3 class="h3">The gear</h3>
      <p class="sub">Click anything in the rack, or pick it from the list.</p>
      <div class="rig-grid">
        <figure class="rack-fig">
          <svg class="rack" data-rack viewBox="0 0 440 520" role="group" aria-label="The home server gear, drawn as a rack, with clickable devices">
            <rect x="20" y="10" width="400" height="500" rx="12" class="r-frame" />
            <rect x="34" y="22" width="14" height="476" rx="2" class="r-rail" />
            <rect x="392" y="22" width="14" height="476" rx="2" class="r-rail" />
            {Array.from({ length: 24 }, (_, i) => (
              <g class="r-holes">
                <rect x="38" y={30 + i * 19.6} width="6" height="6" rx="1" />
                <rect x="396" y={30 + i * 19.6} width="6" height="6" rx="1" />
              </g>
            ))}

            <g class="gear" data-gear="router" tabindex="0" role="button" aria-label="Router and firewall">
              <rect x="52" y="30" width="336" height="44" rx="5" class="u" />
              <text x="66" y="57" class="u-t">hEX</text>
              {[0, 1, 2, 3, 4].map((n) => (
                <g><rect x={200 + n * 34} y="40" width="24" height="18" rx="2" class="port" /><circle cx={212 + n * 34} cy="65" r="2.6" class={`led g b${n % 3}`} /></g>
              ))}
              <circle cx="372" cy="52" r="3" class="led g" />
            </g>

            <g class="gear" data-gear="switch" tabindex="0" role="button" aria-label="Switch">
              <rect x="52" y="84" width="336" height="44" rx="5" class="u" />
              <text x="66" y="111" class="u-t">GS1900</text>
              {[0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
                <g><rect x={160 + n * 26} y="93" width="20" height="17" rx="2" class="port" /><circle cx={170 + n * 26} cy="118" r="2.4" class={n < 5 ? `led g b${(n + 1) % 3}` : 'led off'} /></g>
              ))}
              <circle cx="372" cy="106" r="3" class="led g" />
            </g>

            <g class="gear" data-gear="server" tabindex="0" role="button" aria-label="Server">
              <rect x="52" y="138" width="336" height="96" rx="6" class="u srv" />
              {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
                <rect x={70 + n * 14} y="156" width="6" height="60" rx="3" class="vent" />
              ))}
              <text x="210" y="176" class="u-t big">OPTIPLEX</text>
              <rect x="210" y="190" width="110" height="8" rx="2" class="slot" />
              <circle cx="356" cy="168" r="11" class="pwr" />
              <circle cx="356" cy="168" r="11" class="pwr-ring" />
              <circle cx="356" cy="200" r="2.8" class="led a b1" />
            </g>

            <g class="gear" data-gear="media" tabindex="0" role="button" aria-label="Media drive">
              <rect x="52" y="244" width="336" height="56" rx="6" class="u drv" />
              {[0, 1, 2, 3, 4, 5].map((n) => (
                <rect x="70" y={254 + n * 6} width="120" height="2.5" rx="1" class="grille" />
              ))}
              <text x="210" y="278" class="u-t">8 TB</text>
              <circle cx="372" cy="272" r="3" class="led w b2" />
            </g>

            <g class="gear" data-gear="backup" tabindex="0" role="button" aria-label="Backup drive">
              <rect x="52" y="310" width="336" height="56" rx="6" class="u drv" />
              {[0, 1, 2, 3, 4, 5].map((n) => (
                <rect x="70" y={320 + n * 6} width="120" height="2.5" rx="1" class="grille" />
              ))}
              <text x="210" y="344" class="u-t">8 TB BACKUP</text>
              <circle cx="372" cy="338" r="3" class="led w slow" />
            </g>

            <g class="gear" data-gear="offsite" tabindex="0" role="button" aria-label="Offsite drive">
              <rect x="52" y="376" width="336" height="44" rx="5" class="u empty" />
              <text x="220" y="403" class="u-t faint off-away" text-anchor="middle">OFFSITE DRIVE: OUT OF THE HOUSE</text>
              <g class="off-home">
                <rect x="60" y="382" width="320" height="32" rx="4" class="u-in" />
                <text x="210" y="403" class="u-t">4 TB OFFSITE</text>
                <circle cx="364" cy="398" r="3" class="led w b0" />
              </g>
            </g>

            <g class="gear" data-gear="ups" tabindex="0" role="button" aria-label="UPS">
              <rect x="52" y="430" width="336" height="68" rx="6" class="u ups" />
              <rect x="70" y="446" width="84" height="36" rx="4" class="lcd" />
              <text x="112" y="470" class="lcd-t" text-anchor="middle" data-lcd>100%</text>
              <text x="180" y="469" class="u-t">CYBERPOWER</text>
              <circle cx="356" cy="464" r="10" class="pwr" />
              <circle cx="356" cy="464" r="10" class="pwr-ring" />
            </g>
          </svg>
          <figcaption>A drawing, not a photo. There's no actual rack: in real life all of this sits in a corner.</figcaption>
        </figure>

        <div class="side">
          <div class="detail" aria-live="polite">
            <p class="eyebrow" data-g-name>Gear</p>
            <h3 data-g-model>Pick something in the rack</h3>
            <p data-g-why>Seven things keep the house online. One of them is usually somewhere else.</p>
            <div class="story-nav" data-story-nav hidden>
              <button type="button" class="view-btn quiet" data-story-prev>Back</button>
              <span class="story-count" data-story-count></span>
              <button type="button" class="view-btn" data-story-next>Next</button>
            </div>
          </div>
          <div class="story-bar" data-story-bar hidden>
            <span class="k">Play it out</span>
            {stories.map((st) => (
              <button type="button" class="view-btn quiet" data-story={st.id} aria-pressed="false">{st.label}</button>
            ))}
          </div>
          {stories.map((st) => (
            <details class="story-text" data-story-text>
              <summary>{st.label}</summary>
              <ol>
                {st.steps.map((x) => (
                  <li><strong>{x.title}.</strong> {x.text}</li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </div>

      <table class="specs">
        <caption class="sr-only">Home server gear</caption>
        <thead><tr><th>Gear</th><th>Model</th><th>Notes</th></tr></thead>
        <tbody>
          {gear.map((g) => (
            <tr data-gear-row={g.id}>
              <th scope="row"><button type="button" class="row-btn" data-gear={g.id}>{g.name}</button></th>
              <td class="model">{g.model}</td>
              <td>{g.why}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h3 class="h3">Then and now</h3>
      <p class="sub">The 2009 office PC this all started on, next to the server that replaced it.</p>
      <div class="cmp" data-cmp>
        <div class="cmp-bar" data-cmp-bar hidden role="group" aria-label="Show which server">
          <button type="button" class="view-btn" data-cmp-pick="then" aria-pressed="false">2009 office PC</button>
          <button type="button" class="view-btn" data-cmp-pick="now" aria-pressed="true">Dell OptiPlex 5050</button>
        </div>
        <dl class="cmp-rows">
          {compare.map((r) => {
            const max = Math.max(r.a ?? 0, r.b ?? 0);
            return (
              <div class="cmp-row">
                <dt>{r.k}</dt>
                <dd>
                  <span class="v-then">{r.then}</span><span class="v-arrow" aria-hidden="true"> to </span><span class="v-now">{r.now}</span>
                  {max > 0 && (
                    <span class="cmp-meter" aria-hidden="true" data-then={String(Math.round(((r.a ?? 0) / max) * 100))} data-now={String(Math.round(((r.b ?? 0) / max) * 100))}><span class="cmp-fill"></span></span>
                  )}
                </dd>
              </div>
            );
          })}
        </dl>
        <p class="note">* Measured on my own hardware. Old drive speed: copying a 2.3 GB backup over USB 2.0. New: reading from the media drive over USB 3.0. Both transcoding numbers are from the new server, with and without Quick Sync.</p>
      </div>

      <h3 class="h3">How a request gets in (or doesn't)</h3>
      <p class="sub">Pick a request and watch where it goes.</p>
      <div class="trace-bar" data-trace-bar hidden>
        {traces.map((t) => (
          <button type="button" class="view-btn quiet" data-trace={t.id} data-path={t.path} data-ok={String(t.ok)} data-note={t.note} aria-pressed="false">{t.label}</button>
        ))}
      </div>
      <p class="trace-note" data-trace-note aria-live="polite"></p>

      <div class="zones-scroll" data-zones-wrap>
      <svg class="zones" data-zones viewBox="0 0 900 360" role="img" aria-labelledby="zones-t zones-d">
