              {[0, 1, 2, 3, 4, 5].map((n) => (
                <rect x="70" y={320 + n * 6} width="120" height="2.5" rx="1" class="grille" />
              ))}
              <text x="210" y="344" class="u-t">8 TB BACKUP</text>
              <circle cx="372" cy="338" r="3" class="led w slow" />
            </g>

            <g class="gear" data-gear="offsite" tabindex="0" role="button" aria-label="Offsite drive">
              <rect x="52" y="376" width="336" height="44" rx="5" class="u empty" />
              <text x="220" y="403" class="u-t faint" text-anchor="middle">OFFSITE DRIVE: OUT OF THE HOUSE</text>
            </g>

            <g class="gear" data-gear="ups" tabindex="0" role="button" aria-label="UPS">
              <rect x="52" y="430" width="336" height="68" rx="6" class="u ups" />
              <rect x="70" y="446" width="84" height="36" rx="4" class="lcd" />
              <text x="112" y="470" class="lcd-t" text-anchor="middle">100%</text>
              <text x="180" y="469" class="u-t">CYBERPOWER</text>
              <circle cx="356" cy="464" r="10" class="pwr" />
              <circle cx="356" cy="464" r="10" class="pwr-ring" />
            </g>
          </svg>
          <figcaption>A drawing, not a photo. There's no actual rack: in real life all of this sits in a corner.</figcaption>
        </figure>

        <div class="detail" aria-live="polite">
          <p class="eyebrow" data-g-name>Gear</p>
          <h3 data-g-model>Pick something in the rack</h3>
          <p data-g-why>Seven things keep the house online. One of them is usually somewhere else.</p>
        </div>
      </div>

      <table class="specs">
        <caption class="sr-only">Home server gear</caption>
        <thead><tr><th>Gear</th><th>Model</th><th>Notes</th></tr></thead>
        <tbody>
