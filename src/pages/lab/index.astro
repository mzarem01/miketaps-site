            <tr data-gear-row={g.id}>
              <th scope="row"><button type="button" class="row-btn" data-gear={g.id}>{g.name}</button></th>
              <td class="model">{g.model}</td>
              <td>{g.why}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h3 class="h3">How a request gets in (or doesn't)</h3>
      <p class="sub">Pick a request and watch where it goes.</p>
      <div class="trace-bar" data-trace-bar hidden>
        {traces.map((t) => (
          <button type="button" class="view-btn quiet" data-trace={t.id} data-path={t.path} data-ok={String(t.ok)} data-note={t.note} aria-pressed="false">{t.label}</button>
        ))}
      </div>
      <p class="trace-note" data-trace-note aria-live="polite"></p>

      <svg class="zones" data-zones viewBox="0 0 900 360" role="img" aria-labelledby="zones-t zones-d">
        <title id="zones-t">How traffic reaches the home network</title>
        <desc id="zones-d">Visitors reach this site through Cloudflare and an outbound tunnel. Mike's own devices use a private mesh VPN. Inside the house, the router firewall only lets other devices reach a short list of services on the server.</desc>
        <defs>
          <marker id="za" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="ar" /></marker>
        </defs>
        <rect x="20" y="30" width="190" height="300" rx="14" class="zone z-out" />
        <text x="40" y="62" class="zt">The internet</text>
        <rect x="42" y="90" width="146" height="54" rx="10" class="node" />
        <text x="115" y="122" class="nt" text-anchor="middle">Visitors</text>
        <rect x="42" y="230" width="146" height="54" rx="10" class="node" />
        <text x="115" y="255" class="nt" text-anchor="middle">My phone</text>
        <text x="115" y="273" class="ns" text-anchor="middle">and laptops</text>

        <rect x="250" y="80" width="150" height="74" rx="12" class="node accent" />
        <text x="325" y="112" class="nt" text-anchor="middle">Cloudflare</text>
        <text x="325" y="132" class="ns" text-anchor="middle">HTTPS at the edge</text>

        <rect x="440" y="30" width="440" height="300" rx="14" class="zone z-home" />
        <text x="460" y="62" class="zt">Home</text>
        <rect x="460" y="80" width="180" height="230" rx="12" class="zone z-srv" />
        <text x="624" y="102" class="zt small" text-anchor="end">server zone</text>
        <rect x="476" y="122" width="148" height="46" rx="9" class="node accent" />
        <text x="550" y="150" class="nt" text-anchor="middle">This site</text>
        <rect x="476" y="182" width="148" height="46" rx="9" class="node" />
        <text x="550" y="210" class="nt" text-anchor="middle">Media server</text>
        <rect x="476" y="242" width="148" height="52" rx="9" class="node dashed" />
        <text x="550" y="264" class="nt" text-anchor="middle">Everything else</text>
        <text x="550" y="282" class="ns" text-anchor="middle">private, VPN only</text>

        <rect x="680" y="110" width="180" height="70" rx="12" class="node" />
        <text x="770" y="140" class="nt" text-anchor="middle">Router firewall</text>
        <text x="770" y="160" class="ns" text-anchor="middle">allows DNS and media only</text>
        <rect x="680" y="220" width="180" height="70" rx="12" class="node" />
        <text x="770" y="250" class="nt" text-anchor="middle">Wi-Fi devices</text>
        <text x="770" y="270" class="ns" text-anchor="middle">TVs, phones, IoT</text>

        <path d="M188 117H250" class="ln" marker-end="url(#za)" />
        <path d="M400 117H440L460 140H476" class="ln" marker-end="url(#za)" />
        <text x="325" y="174" class="ns" text-anchor="middle">outbound tunnel to home</text>
        <path d="M188 257H420V268H476" class="ln vpn" marker-end="url(#za)" />
        <text x="250" y="248" class="ns">private mesh VPN</text>
        <path d="M770 220V180" class="ln" marker-end="url(#za)" />
        <path d="M680 145H624" class="ln" marker-end="url(#za)" />
      </svg>

      <ul class="services">
        {services.map((s) => (
          <li><strong>{s.name}</strong><span>{s.note}</span></li>
        ))}
      </ul>
      <p class="note">Addresses, hostnames, ports and the rest of the private details are left out on purpose.</p>
    </section>

    <section id="site" class="wrap colophon" aria-labelledby="site-h">
      <h2 id="site-h">How this site runs</h2>
      <p class="sub">
        Built with Astro into plain HTML, CSS and a little JavaScript. No database, no logins, no
        trackers. Served from the home server above.
      </p>
      <ol class="steps">
        <li><span class="sn">1</span><strong>A change goes up as a pull request.</strong> Automated checks build the site and scan it for anything private.</li>
        <li><span class="sn">2</span><strong>I review and merge it.</strong> Nothing goes live without that.</li>
        <li><span class="sn">3</span><strong>GitHub builds a release.</strong> A tarball of the site plus its checksum.</li>
        <li><span class="sn">4</span><strong>The server pulls it.</strong> Every few minutes it checks for a new release, verifies the checksum, and swaps it in. It never accepts an incoming connection to deploy.</li>
        <li><span class="sn">5</span><strong>Cloudflare serves it to you.</strong> Through an outbound-only tunnel, so no ports are open at home.</li>
      </ol>
      <div class="facts">
        <div><span class="k">Container</span><span class="v">Unprivileged nginx, read-only, no capabilities, 64 MB memory cap</span></div>
        <div><span class="k">Rollback</span><span class="v">One command switches back to the previous release</span></div>
        <div><span class="k">If my internet goes down</span><span class="v">Cloudflare shows an archived copy until it's back</span></div>
        <div><span class="k">Your data</span><span class="v">Nothing collected. Your browser remembers the lamp, your cards and your belt stripes, and that's it</span></div>
        <div><span class="k">This version</span><span class="v">Built {built}</span></div>
        <div><span class="k">Source</span><span class="v"><a href="https://github.com/mzarem01/miketaps-site">github.com/mzarem01/miketaps-site</a></span></div>
      </div>
    </section>
  </div>
  <script is:inline src={`/js/lab.js?v=${BUILD}`} defer></script>
  <script>
    // "View in 3D": only offered when the browser can draw WebGL. The 3D code (Three.js) is a
    // separate file that downloads on the first tap, so the page stays light until then.
    const btn = document.querySelector<HTMLButtonElement>('[data-rig-3d]');
    const stage = document.querySelector<HTMLElement>('[data-rig-stage]');
    const hint = document.querySelector<HTMLElement>('[data-rig-hint]');
    const flat = document.querySelector<SVGElement>('svg.case');
    const labelsBtn = document.querySelector<HTMLButtonElement>('[data-rig-labels]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-rig-reset]');

    function webgl() {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    }

    if (btn && stage && hint && flat && labelsBtn && resetBtn && webgl()) {
      btn.hidden = false;
      let view: {
        select(id: string | null): void;
        show(on: boolean): void;
        labels(on: boolean): void;
        reset(): void;
      } | null = null;
      // Labels start on for touch screens, where there is no hover to show what's clickable.
      let labelsOn = window.matchMedia('(pointer: coarse)').matches;

      labelsBtn.addEventListener('click', () => {
        labelsOn = !labelsOn;
        labelsBtn.setAttribute('aria-pressed', String(labelsOn));
        labelsBtn.textContent = labelsOn ? 'Hide labels' : 'Show labels';
        view?.labels(labelsOn);
      });
      resetBtn.addEventListener('click', () => view?.reset());
      let on = false;

      document.addEventListener('rig:selected', (e) => view?.select((e as CustomEvent<string>).detail));

      btn.addEventListener('click', async () => {
        on = !on;
        if (on && !view) {
          btn.disabled = true;
          btn.textContent = 'Loading the 3D model';
          try {
            const { initRig } = await import('../../scripts/rig3d.js');
            stage.hidden = false;
            const names: Record<string, string> = {};
            document.querySelectorAll('[data-row]').forEach((r) => {
              names[r.getAttribute('data-row') ?? ''] = r.querySelector('th')?.textContent?.trim() ?? '';
            });
            view = initRig(stage, names);
            view.labels(labelsOn);
            labelsBtn.setAttribute('aria-pressed', String(labelsOn));
            labelsBtn.textContent = labelsOn ? 'Hide labels' : 'Show labels';
            const current = document.querySelector('[data-row].on');
            if (current) view.select(current.getAttribute('data-row'));
          } catch {
            on = false;
            stage.hidden = true;
            btn.textContent = 'View in 3D';
            btn.disabled = false;
            hint.hidden = false;
            hint.textContent = "The 3D view didn't load. The drawing still works.";
            return;
          }
          btn.disabled = false;
        }
        stage.hidden = !on;
        flat.style.display = on ? 'none' : '';
        hint.hidden = !on;
        labelsBtn.hidden = !on;
        resetBtn.hidden = !on;
        btn.textContent = on ? 'Back to the drawing' : 'View in 3D';
        btn.setAttribute('aria-pressed', String(on));
        view?.show(on);
      });
    }
  </script>
</Base>

