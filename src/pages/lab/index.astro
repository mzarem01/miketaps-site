  <script>
    // "View in 3D": only offered when the browser can draw WebGL. The 3D code (Three.js) is a
    // separate file that downloads on the first tap, so the page stays light until then.
    const btn = document.querySelector<HTMLButtonElement>('[data-rig-3d]');
    const stage = document.querySelector<HTMLElement>('[data-rig-stage]');
    const hint = document.querySelector<HTMLElement>('[data-rig-hint]');
    const flat = document.querySelector<SVGElement>('svg.case');
    const labelsBtn = document.querySelector<HTMLButtonElement>('[data-rig-labels]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-rig-reset]');

    function webgl() {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    }

    if (btn && stage && hint && flat && labelsBtn && resetBtn && webgl()) {
      btn.hidden = false;
      let view: {
        select(id: string | null): void;
        show(on: boolean): void;
        labels(on: boolean): void;
        reset(): void;
      } | null = null;
      // Labels start on for touch screens, where there is no hover to show what's clickable.
      let labelsOn = window.matchMedia('(pointer: coarse)').matches;

      labelsBtn.addEventListener('click', () => {
        labelsOn = !labelsOn;
        labelsBtn.setAttribute('aria-pressed', String(labelsOn));
        labelsBtn.textContent = labelsOn ? 'Hide labels' : 'Show labels';
        view?.labels(labelsOn);
      });
      resetBtn.addEventListener('click', () => view?.reset());
      let on = false;

      document.addEventListener('rig:selected', (e) => view?.select((e as CustomEvent<string>).detail));

      btn.addEventListener('click', async () => {
        on = !on;
        if (on && !view) {
          btn.disabled = true;
          btn.textContent = 'Loading the 3D model';
          try {
            const { initRig } = await import('../../scripts/rig3d.js');
            stage.hidden = false;
            const names: Record<string, string> = {};
            document.querySelectorAll('[data-row]').forEach((r) => {
              names[r.getAttribute('data-row') ?? ''] = r.querySelector('th')?.textContent?.trim() ?? '';
            });
            view = initRig(stage, names);
            view.labels(labelsOn);
            labelsBtn.setAttribute('aria-pressed', String(labelsOn));
            labelsBtn.textContent = labelsOn ? 'Hide labels' : 'Show labels';
            const current = document.querySelector('[data-row].on');
            if (current) view.select(current.getAttribute('data-row'));
          } catch {
            on = false;
            stage.hidden = true;
            btn.textContent = 'View in 3D';
            btn.disabled = false;
            hint.hidden = false;
            hint.textContent = "The 3D view didn't load. The drawing still works.";
            return;
          }
          btn.disabled = false;
        }
        stage.hidden = !on;
        flat.style.display = on ? 'none' : '';
        hint.hidden = !on;
        labelsBtn.hidden = !on;
        resetBtn.hidden = !on;
        btn.textContent = on ? 'Back to the drawing' : 'View in 3D';
        btn.setAttribute('aria-pressed', String(on));
        view?.show(on);
      });
    }
  </script>
</Base>

