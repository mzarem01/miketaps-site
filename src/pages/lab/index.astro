---
import { BUILD } from '../../data/build';
import Base from '../../layouts/Base.astro';

const parts = [
  { id: 'cpu', name: 'CPU', model: 'AMD Ryzen 7 9800X3D', why: 'Eight cores with 3D V-Cache. Built for games, and it has plenty left over for everything else I throw at this box.' },
  { id: 'cooler', name: 'Cooler', model: '240 mm liquid cooler', why: 'Keeps the CPU in check day to day. Under an all-out stress test it hits its limit, so a repaste is on my list.' },
  { id: 'gpu', name: 'Graphics', model: 'XFX Radeon RX 9070 XT, 16 GB', why: 'Games, and my local AI. A 35-billion-parameter model fits entirely in its 16 GB once it is squeezed down.' },
  { id: 'ram', name: 'Memory', model: 'G.Skill 2 x 16 GB DDR5-6000', why: '32 GB with EXPO on. Passed four clean passes of MemTest86.' },
  { id: 'board', name: 'Motherboard', model: 'MSI PRO B650-VC WIFI', why: 'AM5, so there is an upgrade path for the CPU later.' },
  { id: 'ssd', name: 'Storage', model: 'WD Green SN3000 2 TB NVMe', why: 'Backed up every night to the home server with Kopia.' },
  { id: 'case', name: 'Case', model: 'HYTE Y40', why: 'Panoramic glass and a vertical GPU. Started life as a prebuilt, and I have been in it plenty since.' },
  { id: 'psu', name: 'Power', model: 'About 850 W, plus a CyberPower 1500 VA UPS', why: 'Tested clean under load. The UPS rides out power blips and talks to the PC over USB.' },
];

const services = [
  { name: 'Media server', note: 'Jellyfin, with hardware transcoding on the Intel iGPU' },
  { name: 'Photos', note: 'Immich, replacing cloud photo storage' },
  { name: 'DNS filtering', note: 'Pi-hole for the whole house' },
  { name: 'Monitoring', note: 'Uptime Kuma with chat alerts, plus an outside check-in for full outages' },
  { name: 'Backups', note: 'Nightly jobs that report in when they finish, a separate backup drive, and a monthly offsite copy' },
  { name: 'Power', note: 'UPS with automatic clean shutdown on low battery' },
  { name: 'This website', note: 'One locked-down container, the only public thing besides the media server' },
];

// The gear around the server, top to bottom as drawn in the rack.
const gear = [
  { id: 'router', name: 'Router and firewall', model: 'MikroTik hEX', why: 'Every connection to the server has to cross it. It runs an allow-list: my desktop gets full access, and everything else in the house gets DNS, the media server and the VPN. Nothing more.' },
  { id: 'switch', name: 'Switch', model: 'Zyxel GS1900-8', why: 'Managed, so it can carry VLANs. It runs on battery with the router, because a server with no network is just a warm box.' },
  { id: 'server', name: 'Server', model: 'Dell OptiPlex 5050 SFF, i7-7700, 32 GB', why: 'A used office PC that replaced my 2009 one in September 2026. It runs about twenty containers with no screen attached, and its Intel graphics handle video transcoding.' },
  { id: 'media', name: 'Media drive', model: '8 TB external', why: 'Pooled with an internal SSD into one folder using mergerfs. No RAID: if one disk dies, the files on the other are still readable, and backups cover the rest.' },
  { id: 'backup', name: 'Backup drive', model: '8 TB external', why: "Holds nothing but backups, and it's kept out of the pool, so one bad command can't wipe both copies. The nightly jobs check in with the monitor when they finish." },
  { id: 'offsite', name: 'Offsite drive', model: '4 TB, rotated monthly', why: "Usually not here, and that's the point. Once a month it gets a fresh copy and leaves the house." },
  { id: 'ups', name: 'UPS', model: 'CyberPower 1000 VA', why: 'Keeps the router, switch and server running through power blips. When the battery runs low, it tells the server to shut itself down cleanly.' },
];

// "Send a request" scenarios for the network diagram. Each path follows the lines drawn in it;
// a jump (M) means the request passes through a box, like Cloudflare or the router.
const traces = [
  { id: 'visitor', label: 'A visitor loads this site', ok: true, path: 'M188 117H250M400 117H440L460 140H476', note: 'Cloudflare handles HTTPS, then hands the request down a tunnel the server opened from inside the house. No port is open at home.' },
  { id: 'phone', label: 'I check the server from my phone', ok: true, path: 'M188 257H420V268H476', note: 'My own devices use a private mesh VPN. That is the only way in to the private services.' },
  { id: 'probe', label: 'Someone looks for an admin page', ok: false, path: 'M188 117H250', note: "Stopped at Cloudflare. Only this site and the media server are published, and every other path or hostname gets a 404. Nothing at home is listening for the internet." },
  { id: 'tv', label: 'A TV in the house plays a movie', ok: true, path: 'M770 220V180M680 145H640V205H624', note: 'The router firewall lets other devices in the house reach the media server and DNS.' },
  { id: 'cam', label: 'The pet camera pokes at the server', ok: false, path: 'M770 220V180', note: 'Dropped and logged by the router. Devices in the house only get what they need, and everything else on the server is off limits to them.' },
];

const built = new Date().toISOString().slice(0, 10);
---
<Base title="The Lab" description="The rig, the home server, and how this site runs, minus the private bits." accent="#3f8f6a">
  <div class="lab">
    <section class="wrap head">
      <p class="eyebrow">The Lab</p>
      <h1>The hardware behind it all.</h1>
      <p class="lede">My main rig, the home server that runs the house, and how this site gets from my keyboard to your screen.</p>
      <nav class="jump" aria-label="On this page">
        <a href="#rig">The rig</a>
        <a href="#homelab">The home server</a>
        <a href="#site">How this site runs</a>
      </nav>
    </section>

    <section id="rig" class="wrap rig" aria-labelledby="rig-h">
      <h2 id="rig-h">The rig</h2>
      <p class="sub">Click a part, or pick one from the list.</p>
      <div class="rig-grid">
        <div class="rig-view">
        <div class="view-bar">
          <button type="button" class="view-btn" data-rig-3d aria-pressed="false" hidden>View in 3D</button>
          <button type="button" class="view-btn quiet" data-rig-labels aria-pressed="false" hidden>Show labels</button>
          <button type="button" class="view-btn quiet" data-rig-reset hidden>Reset view</button>
          <span class="view-hint" data-rig-hint hidden>Drag to turn it, scroll or pinch to zoom, click a part.</span>
        </div>
        <div class="stage" data-rig-stage role="group" aria-label="3D model of the rig. Turn on labels to pick parts in the model, or use the parts list below." hidden></div>
        <svg class="case" viewBox="0 0 520 440" role="group" aria-label="The rig, with clickable parts">
