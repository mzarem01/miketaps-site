          <h3 data-p-model>Pick something in the case</h3>
          <p data-p-why>Every part has a reason it's in there. Some reasons are better than others.</p>
        </div>
      </div>

      <table class="specs">
        <caption class="sr-only">Full parts list</caption>
        <thead><tr><th>Part</th><th>Model</th><th>Notes</th></tr></thead>
        <tbody>
          {parts.map((p) => (
            <tr data-row={p.id}>
              <th scope="row"><button type="button" class="row-btn" data-part={p.id}>{p.name}</button></th>
              <td class="model">{p.model}</td>
              <td>{p.why}</td>
