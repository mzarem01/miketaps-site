---
import Base from '../../layouts/Base.astro';
import WristLock from '../../components/WristLock.astro';
import { BUILD } from '../../data/build';

const belts = [
  { name: 'White', color: '#f2ede4', bar: '#151012' },
  { name: 'Blue', color: '#2f5fa8', bar: '#151012' },
  { name: 'Purple', color: '#5d3d91', bar: '#151012', me: true },
  { name: 'Brown', color: '#6b4226', bar: '#151012' },
  { name: 'Black', color: '#141012', bar: '#b0303f' },
];

// Three matches Mike keeps rewatching. Facts checked against match reports (Nov 2026).
// Two have no official YouTube upload, so they link to long-standing fan uploads; swap the url if one disappears.
const matches = [
  {
    title: `Kade Ruotolo vs. Andrew Tackett`,
    meta: `Craig Jones Invitational 2024 · Under 80kg semifinal`,
    why: `Fifteen minutes of nonstop chaos. Tackett takes Kade's back in the first round, Kade comes roaring back, and both of them get out of stuff that should have ended it, including a D'Arce and an anaconda with seconds left. Kade took it on a split decision, but honestly nobody lost that one. If you only watch one match on this list, make it this one.`,
    result: `Kade Ruotolo by split decision`,
    url: 'https://www.youtube.com/watch?v=HkwFwGYtqfk',
    src: `Official upload (The B-Team)`,
  },
  {
    title: `Marcelo Garcia vs. Kron Gracie`,
    meta: `ADCC 2009 · Barcelona · 77kg quarterfinal`,
    why: `An absolute classic. Ten scoreless minutes and into overtime, two of the best ever trading attacks. Kron almost gets Marcelo with a guillotine, Marcelo stays calm and gets out, then passes, climbs to mount and finishes Kron with his own guillotine. Immaculate. Still one of my favorite matches to watch.`,
    result: `Marcelo Garcia by guillotine`,
    url: 'https://www.youtube.com/watch?v=ebujdnSwlR4',
    src: `Fan upload (no official copy on YouTube)`,
  },
  {
    title: `Ronaldo "Jacaré" Souza vs. Roger Gracie`,
    meta: `2004 Worlds · Absolute final · Tijuca Tênis Clube, Rio`,
    why: `Roger locks up an armlock and Jacaré refuses to tap. The elbow pops. He tucks the arm into his belt and fights the rest of the match one-handed to hold onto his lead. Not saying anybody should copy that, but it's one of the toughest things I've ever seen on a mat.`,
    result: `Jacaré on points, 4 to 2`,
    url: 'https://www.youtube.com/watch?v=SWxPTrESldw',
    src: `Fan upload (no official copy on YouTube)`,
  },
];
---
<Base title="The Mat" description="Jiu-jitsu since 2010: the belt path and three matches I'll never stop rewatching." accent="#6a4a9c">
  <div class="mat">
    <section class="wrap head">
      <div class="head-text">
        <p class="eyebrow">The Mat</p>
        <h1>Purple belt. <span>On the mat since 2010.</span></h1>
        <p class="lede">
          Brazilian jiu-jitsu has been part of my life for over fifteen years, training and coaching.
          It's problem solving with someone actively trying to solve you back, which is not that
          different from security work.
        </p>
      </div>
      <div class="head-art">
        <WristLock />
      </div>
    </section>

    <section class="wrap belts" aria-labelledby="belts-h">
      <h2 id="belts-h" class="sec-h">The path</h2>
      <ol class="belt-row">
        {belts.map((b) => (
          <li class={b.me ? 'belt me' : 'belt'}>
            <span class="strip" style={`--c:${b.color};--bar:${b.bar}`} aria-hidden="true"></span>
            <span class="b-name">{b.name}</span>
            {b.me && <span class="here">I'm here</span>}
          </li>
        ))}
      </ol>
      <p class="note">Adult belts in BJJ often take years each. There's no shortcut, which is the point.</p>
    </section>

    <section class="wrap matches" aria-labelledby="matches-h">
      <h2 id="matches-h" class="sec-h">Three matches I'll never stop rewatching</h2>
      <p class="sub">Not my matches. The ones I keep going back to.</p>
      <ol class="cards">
        {matches.map((m, i) => (
          <li class="card">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="meta">{m.meta}</p>
            <h3>{m.title}</h3>
            <p class="why">{m.why}</p>
            <div class="foot">
              <p class="result">Result: {m.result}</p>
              <a class="watch" href={m.url} target="_blank" rel="noopener noreferrer">
                Watch on YouTube<span class="sr-only"> (opens in a new tab)</span>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3h7v7M13 3L4 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <p class="src">{m.src}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
  <script is:inline src={`/js/wristlock.js?v=${BUILD}`} defer></script>
</Base>

<style>
  .mat {
    --accent: #6a4a9c;
  }
  :global(:root[data-theme='dark']) .mat {
    --accent: #b9a0e6;
  }
  .head {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .head-text {
    flex: 1 1 26rem;
    min-width: 0;
  }
  .head-art {
    flex: 0 1 340px;
    display: flex;
    justify-content: center;
  }
  .head h1 span {
    display: block;
    color: var(--accent);
    font-style: italic;
    font-weight: 450;
  }
  .lede {
    max-width: 42rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .sec-h {
    font-size: 1.7rem;
  }
  .belts {
    padding-top: 2rem;
  }
  .belt-row {
    list-style: none;
    padding: 1.5rem;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(90deg, transparent 0 60px, rgba(0, 0, 0, 0.05) 60px 61px),
      #2d3b4a;
  }
  .belt {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    color: #e8eef3;
    opacity: 0.75;
    transition: opacity var(--base) var(--ease), transform var(--base) var(--pop);
  }
  .belt:hover {
    opacity: 1;
    transform: translateY(-3px);
  }
  .belt.me {
    opacity: 1;
  }
  .strip {
    width: 100%;
    height: 22px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--c) 0 72%, var(--bar) 72% 92%, var(--c) 92%);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.3);
  }
  .me .strip {
    height: 28px;
    outline: 2px solid #e2c27a;
    outline-offset: 3px;
  }
  .b-name {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .here {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #e2c27a;
  }
  .note {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-top: 0.8rem;
  }
  .matches {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
  .sub {
    color: var(--ink-soft);
    margin-top: 0;
  }
  .cards {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.4rem 1.2rem;
    border-radius: 14px;
    border: 1px solid var(--rule);
    background: var(--card);
    transition: border-color var(--base) var(--ease), transform var(--base) var(--pop);
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .card h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .why {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .foot {
    margin-top: auto;
    padding-top: 0.4rem;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .result {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--fast) var(--ease);
  }
  .watch:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .watch:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .src {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  @media (max-width: 640px) {
    .belt-row {
      grid-template-columns: 1fr;
    }
    .strip {
      width: 70%;
    }
  }
</style>
