---
import Base from '../../layouts/Base.astro';

const belts = [
  { name: 'White', color: '#f2ede4', bar: '#151012' },
  { name: 'Blue', color: '#2f5fa8', bar: '#151012' },
  { name: 'Purple', color: '#5d3d91', bar: '#151012', me: true },
  { name: 'Brown', color: '#6b4226', bar: '#151012' },
  { name: 'Black', color: '#141012', bar: '#b0303f' },
];

// Standard IBJJF positional points, with a plain-words description of each position.
const ladder = [
  { name: 'Back control', pts: 4, what: 'Behind your opponent with both hooks in. The strongest position in the sport: they can\'t see you, and every submission is close.' },
  { name: 'Mount', pts: 4, what: 'Sitting on your opponent\'s chest or stomach, knees on the mat. Heavy, hard to escape, and it opens up chokes and armbars.' },
  { name: 'Knee on belly', pts: 2, what: 'One knee driven across the stomach, other leg posted. Mobile and uncomfortable for the bottom person, and a bridge to mount or the back.' },
  { name: 'Guard pass', pts: 3, what: 'Getting past the legs to side control or better. The legs are the bottom player\'s defense, so passing is most of the work on top.' },
  { name: 'Sweep', pts: 2, what: 'From guard, reversing the position so you end up on top. Bottom isn\'t losing if you know how to use it.' },
  { name: 'Takedown', pts: 2, what: 'Bringing a standing opponent to the mat and landing on top.' },
];
---
<Base title="The Mat" description="Jiu-jitsu since 2010: the belt path and the positional ladder." accent="#6a4a9c">
  <div class="mat">
    <section class="wrap head">
      <p class="eyebrow">The Mat</p>
      <h1>Purple belt. <span>On the mat since 2010.</span></h1>
      <p class="lede">
        Brazilian jiu-jitsu has been part of my life for over fifteen years, training and coaching.
        It's problem solving with someone actively trying to solve you back, which is not that
        different from security work.
      </p>
    </section>

    <section class="wrap belts" aria-labelledby="belts-h">
      <h2 id="belts-h" class="sec-h">The path</h2>
      <ol class="belt-row">
        {belts.map((b) => (
          <li class={b.me ? 'belt me' : 'belt'}>
            <span class="strip" style={`--c:${b.color};--bar:${b.bar}`} aria-hidden="true"></span>
            <span class="b-name">{b.name}</span>
            {b.me && <span class="here">I'm here</span>}
          </li>
        ))}
      </ol>
      <p class="note">Adult belts in BJJ often take years each. There's no shortcut, which is the point.</p>
    </section>

    <section class="wrap ladder" aria-labelledby="ladder-h">
      <h2 id="ladder-h" class="sec-h">The positional ladder</h2>
      <p class="sub">"Position before submission." Tap a position to see what it is and what it scores in competition.</p>
      <div class="tiles">
        {ladder.map((p, i) => (
          <details class="tile" style={`--i:${i}`}>
            <summary>
              <span class="rank">{i + 1}</span>
              <span class="p-name">{p.name}</span>
              <span class="pts">{p.pts} pts</span>
            </summary>
            <p>{p.what}</p>
          </details>
        ))}
      </div>
      <p class="note">Points follow the standard IBJJF scoring rules.</p>
    </section>
  </div>
</Base>

<style>
  .mat {
    --accent: #6a4a9c;
  }
  :global(:root[data-theme='dark']) .mat {
    --accent: #b9a0e6;
  }
  .head {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1rem;
  }
  .head h1 span {
    display: block;
    color: var(--accent);
    font-style: italic;
    font-weight: 450;
  }
  .lede {
    max-width: 42rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .sec-h {
    font-size: 1.7rem;
  }
  .belts {
    padding-top: 2rem;
  }
  .belt-row {
    list-style: none;
    padding: 1.5rem;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(90deg, transparent 0 60px, rgba(0, 0, 0, 0.05) 60px 61px),
      #2d3b4a;
  }
  .belt {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    color: #e8eef3;
    opacity: 0.75;
    transition: opacity var(--base) var(--ease), transform var(--base) var(--pop);
  }
  .belt:hover {
    opacity: 1;
    transform: translateY(-3px);
  }
  .belt.me {
    opacity: 1;
  }
  .strip {
    width: 100%;
    height: 22px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--c) 0 72%, var(--bar) 72% 92%, var(--c) 92%);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.3);
  }
  .me .strip {
    height: 28px;
    outline: 2px solid #e2c27a;
    outline-offset: 3px;
  }
  .b-name {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .here {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #e2c27a;
  }
  .note {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-top: 0.8rem;
  }
  .ladder {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
  .sub {
    color: var(--ink-soft);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
  }
  .tile {
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--card);
    overflow: hidden;
    transition: border-color var(--base) var(--ease);
  }
  .tile[open] {
    border-color: var(--accent);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .rank {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .p-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .pts {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .tile p {
    margin: 0;
    padding: 0 1rem 1rem 3.4rem;
    color: var(--ink-soft);
    font-size: 1rem;
    animation: drop 300ms var(--ease);
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 640px) {
    .belt-row {
      grid-template-columns: 1fr;
    }
    .strip {
      width: 70%;
    }
  }
</style>
