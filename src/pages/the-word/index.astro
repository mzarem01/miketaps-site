---
import { BUILD } from '../../data/build';
import Base from '../../layouts/Base.astro';
import data from '../../data/verses.generated.json';

const { moods, translation } = data as any;
---
<Base title="The Word" description="Scripture for whatever you're carrying today. Pick a mood and read slowly." accent="#b08a3e">
  <div class="word">
    <section class="wrap head">
      <p class="eyebrow">The Word</p>
      <h1>What are you carrying today?</h1>
      <p class="lede">Pick whatever fits. Nothing you choose is saved or sent anywhere.</p>
    </section>

    <section class="wrap">
      <div class="moods" role="tablist" aria-label="Moods" data-moods hidden>
        {moods.map((m: any, i: number) => (
          <button
            type="button"
            role="tab"
            class="mood"
            id={`tab-${m.id}`}
            aria-controls={`panel-${m.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-mood={m.id}
          >
            <span class="m-name">{m.name}</span>
            <span class="m-line">{m.line}</span>
          </button>
        ))}
      </div>

      <div class="panels">
        {moods.map((m: any) => (
          <section class="panel" id={`panel-${m.id}`} role="tabpanel" aria-labelledby={`tab-${m.id}`} data-panel={m.id}>
            <h2 class="panel-h">{m.name}</h2>
            {m.verses.map((v: any, j: number) => (
              <figure class="verse" data-verse={j}>
                <blockquote>
                  {v.verses.map((x: any) => (
                    <span class="vtext">{v.verses.length > 1 && <sup>{x.n}</sup>}{x.text} </span>
                  ))}
                </blockquote>
                <figcaption>
                  <span class="ref">{v.ref}</span>
                  <span class="tr">WEB</span>
                </figcaption>
              </figure>
            ))}
            <div class="panel-actions" data-actions hidden>
              <button type="button" class="soft-btn" data-another>Another verse</button>
              <button type="button" class="soft-btn" data-copy>Copy</button>
              <span class="copied" data-copied aria-live="polite"></span>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="wrap lookup" aria-labelledby="lookup-h">
      <h2 id="lookup-h">Look up a verse</h2>
      <form class="lk-form" data-lookup>
        <label for="ref" class="sr-only">Bible reference</label>
        <input id="ref" name="ref" type="text" autocomplete="off" placeholder="John 3:16, Psalm 23, Romans 8:28-39" />
        <button type="submit" class="soft-btn">Look up</button>
      </form>
      <p class="lk-err" data-lookup-error role="alert"></p>
      <div class="lk-out" data-lookup-out aria-live="polite"></div>
    </section>

    <section class="wrap about-text">
      <p>
        Scripture quotations are from the {translation}, which is in the public domain. This is the
        classic edition, which uses the name "Yahweh" in the Old Testament where many translations
        print "the LORD." The text is copied exactly from the published edition and is never edited here.
      </p>
    </section>
  </div>
  <script is:inline src={`/js/word.js?v=${BUILD}`} defer></script>
</Base>

<style>
  .word {
    --accent: #8a6a24;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(194, 155, 69, 0.12), transparent 55%);
  }
  :global(:root[data-theme='dark']) .word {
    --accent: #e2c27a;
  }
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: 1.5rem;
    text-align: center;
  }
  .head h1 {
    font-style: italic;
    font-weight: 450;
  }
  .lede {
    color: var(--ink-soft);
  }
  .moods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.6rem;
    max-width: 56rem;
    margin: 0 auto;
  }
  .mood {
    text-align: left;
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border-radius: 18px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--base) var(--ease), background-color var(--base) var(--ease), transform var(--fast) var(--pop);
  }
  .mood:hover {
    border-color: var(--gold);
  }
  .mood:active {
    transform: scale(0.98);
  }
  .mood[aria-selected='true'] {
    background: var(--gold-tint);
    border-color: var(--gold);
  }
  .m-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .m-line {
    font-size: 0.85rem;
    color: var(--ink-faint);
    line-height: 1.35;
  }
  .panels {
    max-width: 44rem;
    margin: 2.5rem auto 0;
  }
  .panel-h {
    font-size: 1rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  :global(.js) .panel-h {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  :global(.js) .panel:not(.active),
  :global(.js) .verse:not(.active) {
    display: none;
  }
  .verse {
    margin: 0 0 2.5rem;
    text-align: center;
  }
  :global(.js) .verse.active {
    animation: fadein 700ms var(--ease);
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
    line-height: 1.45;
    font-weight: 400;
  }
  sup {
    font-family: var(--font-mono);
    font-size: 0.45em;
    color: var(--ink-faint);
    margin-right: 0.15em;
  }
  figcaption {
    margin-top: 1.1rem;
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
  }
  .ref {
    font-weight: 700;
    color: var(--accent);
  }
  .tr {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink-faint);
  }
  .panel-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
  }
  .soft-btn {
    font: 600 0.95rem/1 var(--font-sans);
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--base) var(--ease), transform var(--fast) var(--pop);
  }
  .soft-btn:hover {
    border-color: var(--gold);
  }
  .soft-btn:active {
    transform: scale(0.96);
  }
  .copied {
    font-size: 0.85rem;
    color: var(--ink-faint);
    min-width: 4rem;
  }
  .lookup {
    max-width: 44rem;
    margin: 4rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .lookup h2 {
    font-size: 1.5rem;
  }
  .lk-form {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    min-width: 0;
    font: 1rem var(--font-sans);
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
  }
  input:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .lk-err {
    color: var(--burgundy-text);
    font-size: 0.95rem;
    min-height: 1.5em;
    margin: 0.5rem 0 0;
  }
  .lk-out :global(.lk-ref) {
    font-weight: 700;
    color: var(--accent);
    margin-top: 1rem;
  }
  .lk-out :global(.lk-text) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.6;
  }
  .lk-out :global(sup) {
    font-family: var(--font-mono);
    font-size: 0.55em;
    color: var(--ink-faint);
    margin-right: 0.15em;
  }
  .about-text {
    max-width: 44rem;
    margin: 2.5rem auto 3rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  @keyframes fadein {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
</style>
